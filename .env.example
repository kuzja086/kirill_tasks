# Шаблон переменных окружения функции. Скопируйте в .env (файл в .gitignore).
# Значения попадают в переменные окружения версии функции Cloud Functions.

# Postgres развёрнут локально и опубликован в интернет.
PG_HOST=203.0.113.10
PG_PORT=5432
PG_DATABASE=alice_skill
PG_USER=alice_skill

# Пароль храните в Yandex Lockbox и передавайте через -SecretKeys PG_PASSWORD
# (см. README, раздел «Секреты Yandex Lockbox»). Тогда эту строку в .env
# оставлять не нужно: deploy.ps1 не передаёт её открытым текстом.
PG_PASSWORD=change-me

# require — TLS обязателен (рекомендуется при доступе из интернета),
# prefer — TLS если сервер умеет, иначе открыто (fallback),
# disable — без TLS. Допустимы и псевдонимы: enable/on -> require, off -> disable.
# Если сервер отвечает «server does not support SSL», включите SSL в Postgres
# либо временно поставьте prefer.
PG_SSLMODE=require

# Необязательно: подключиться по IP, оставив PG_HOST для проверки сертификата.
# Полезно, когда DNS отдаёт неверный адрес.
# PG_HOSTADDR=203.0.113.10

# Таймаут установки соединения, секунды. Должен быть меньше таймаута функции.
PG_CONNECT_TIMEOUT=5

# --- Веб-админка (docker compose) ---
# Пароль входа; без него админка не запускается. В функцию эти переменные
# не передаются (deploy.ps1 пропускает ключи ADMIN_*).
ADMIN_PASSWORD=change-me
# Ключ подписи cookie сессии; если не задан, берётся ADMIN_PASSWORD.
ADMIN_SECRET_KEY=change-me-too
# ADMIN_PORT=8080

